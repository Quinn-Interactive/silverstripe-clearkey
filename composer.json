{
  "name": "quinninteractive/silverstripe-clearkey",
  "description": "Silverstripe module to manage partial-cache invalidation",
  "type": "silverstripe-vendormodule",
  "keywords": [
    "silverstripe",
    "cache",
    "caching",
    "key",
    "invalidation",
    "flush"
  ],
  "license": "BSD-3-Clause",
  "authors": [
    {
      "name": "Quinn Interactive, Inc.",
      "email": "support+clearkey@quinn.com",
      "homepage": "https://quinn.com/",
      "role": "Developer"
    }
  ],
  "require": {
    "silverstripe/admin": "^3.0",
    "silverstripe/framework": "^6.0",
    "silverstripe/versioned": "^3.0"
  },
  "require-dev": {
    "cambis/silverstan": "^2.1",
    "cambis/silverstripe-rector": "^2.1",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-deprecation-rules": "^2.0",
    "rector/rector": "^2.2",
    "rector/type-perfect": "^2.1"
  },
  "autoload": {
    "psr-4": {
      "QuinnInteractive\\ClearKey\\": "src/"
    }
  },
  "extra": {
    "expose": [
      "client/images"
    ]
  },
  "prefer-stable": true,
  "minimum-stability": "dev",
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "composer/installers": true,
      "silverstripe/vendor-plugin": true,
      "phpstan/extension-installer": true
    }
  }
}
